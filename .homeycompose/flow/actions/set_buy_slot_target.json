    },
    {
      "type": "autocomplete",
      "name": "slot",
      "title": {
        "en": "Slot",
        "nl": "Tijdslot",
        "af": "Tydgleuf"
      },
      "placeholder": {
        "en": "Slot 1",
        "nl": "Tijdslot 1",
        "af": "Tydgleuf 1"
      }
    },
    {
      "type": "time",
      "name": "start",
      "title": {
        "en": "Start",
        "nl": "Start",
        "af": "Begin"
      },
      "placeholder": {
        "en": "23:30",
        "nl": "23:30",
        "af": "23:30"
      }
    },
    {
      "type": "time",
      "name": "end",
      "title": {
        "en": "End",
        "nl": "Einde",
        "af": "Einde"
      },
      "placeholder": {
        "en": "05:30",
        "nl": "05:30",
        "af": "05:30"
      }
    },
    {
      "type": "number",
      "name": "target",
      "title": {
        "en": "Charge to (%)",
        "nl": "Laden tot (%)",
        "af": "Laai tot (%)"
